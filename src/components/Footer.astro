---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <span>© {year} Hitalo Loose · Dois Vizinhos, PR, Brazil</span>
    <span class="links">
      <a href={GITHUB_URL}>GitHub</a>
      <a href={LINKEDIN_URL}>LinkedIn</a>
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 72px; }
  .row { display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; padding-block: 24px 32px; font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .links { display: flex; gap: 18px; }
</style>
